{
	local_certs
	auto_https disable_redirects
}

# HTTP exists only to send clients to HTTPS. Do not reverse-proxy the API here.
http://:80 {
	redir https://{host}{uri} permanent
}

https://localhost, https://127.0.0.1 {
	tls internal

	handle /api* {
		reverse_proxy app:8080
	}

	handle /uploads* {
		reverse_proxy app:8080
	}

	handle /health {
		reverse_proxy app:8080
	}

	handle /swagger* {
		reverse_proxy app:8080
	}

	handle {
		reverse_proxy frontend:5173
	}
}
