# Optional browser-facing API origin (default: same-origin via Caddy / Vite proxy).
# Compose serves the app at https://localhost — do not set this to an http:// URL.
# VITE_API_BASE_URL=

# Vite HMR client port when the frontend is behind Caddy (set in docker-compose).
# HMR_CLIENT_PORT=443

# Vite dev-server proxy target for host-side `npm run dev` only (Node, not the browser).
# Compose does not publish :8080; use https://localhost for the evaluated stack.
# API_PROXY_TARGET=http://localhost:8080
