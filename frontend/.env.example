# Optional browser-facing API origin (default: same-origin via Vite proxy).
# Example for direct backend access without proxy: http://localhost:8080
# VITE_API_BASE_URL=

# Vite dev-server proxy target (Node only — set in docker-compose for containers).
# Local dev (backend on host): http://localhost:8080
# Docker Compose frontend service: http://app:8080
# API_PROXY_TARGET=http://localhost:8080
